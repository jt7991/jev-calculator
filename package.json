{
  "name": "jev-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "cli": "tsx --env-file-if-exists=.env cli/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@insomnia-dev/words-to-numbers": "^2.2.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "h3": "^2.0.1-rc.32",
    "nitro": "^3.0.260903-beta",
    "svelte": "^5.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
